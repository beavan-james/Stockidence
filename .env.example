# Copy to .env and fill in. Never commit .env.
# Provider keys (free tiers):
FINNHUB_API_KEY=
X_FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
# Local paths / service wiring (sane production defaults in compose):
# DAGSTER_HOME=/app/dagster_home
# STOCKIDENCE_DB=/app/data/stockidence.duckdb
# DAGSTER_WEB_URL=http://dagster-webserver:3000
# Optional pacing overrides (seconds between provider calls):
# FINNHUB_MIN_INTERVAL_S=1.05
# TWELVE_DATA_MIN_INTERVAL_S=2.0
# ALPHA_VANTAGE_MIN_INTERVAL_S=61.0
# FRED_MIN_INTERVAL_S=1.0
